POSTGRES_DB=penny
POSTGRES_USER=penny
POSTGRES_PASSWORD=replace_with_a_unique_random_password
PENNY_HTTP_PORT=80
PENNY_HTTP_BIND=0.0.0.0
PENNY_RELEASE=local
# Optional separate frontend release, falling back to PENNY_RELEASE when empty.
PENNY_FRONTEND_RELEASE=
# Only required to initialize a new empty database; migrated users retain their accounts.
PENNY_BOOTSTRAP_EMAIL=
PENNY_BOOTSTRAP_PASSWORD=
